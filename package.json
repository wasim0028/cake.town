{
  "name": "caketown",
  "version": "2.0.0",
  "private": true,
  "description": "caketown – bakery web and mobile apps with a shared Express + MongoDB API",
  "workspaces": [
    "backend",
    "client",
    "mobile",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev:api": "npm run dev -w @caketown/backend",
    "build:api": "npm run build -w @caketown/backend",
    "start:api": "npm run start -w @caketown/backend",
    "seed": "npm run seed -w @caketown/backend",
    "migrate:users": "npm run migrate:users -w @caketown/backend",
    "test": "npm run test -w @caketown/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev -w @caketown/web",
    "build:web": "npm run build -w @caketown/web",
    "start:web": "npm run start -w @caketown/web",
    "dev:mobile": "npm run start -w @caketown/mobile"
  }
}
