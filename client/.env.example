# Where the Express API runs. The browser never calls it directly: Next.js proxies /api/v1/*
# to it, so login cookies stay on your own domain.
API_URL=http://localhost:5000

# Public address of this site (used for canonical URLs and social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shown on the contact page. The map appears only when the query is set.
NEXT_PUBLIC_SHOP_ADDRESS=
NEXT_PUBLIC_SHOP_MAP_QUERY=
