# Copy to backend/.env and fill in. Only the first block is required;
# every integration below switches on by itself once its keys are filled in.

# ---------- required ----------
NODE_ENV=development
PORT=5000
# MongoDB Atlas (choose the Mumbai ap-south-1 region), or a local mongod for development:
MONGODB_URI=mongodb://127.0.0.1:27017/caketown
# Any long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# ---------- web app ----------
# Browser origins allowed to call the API (comma separated). Mobile apps need no entry.
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app (used in email links).
WEB_URL=http://localhost:3000
# Only when web and API are on different subdomains, e.g. .caketown.in
COOKIE_DOMAIN=
# Number of proxies in front of the API (1 on Render/Railway). Use 0 if clients connect directly.
TRUST_PROXY=1
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# ---------- admin (used by `npm run seed`) ----------
ADMIN_EMAIL=admin@caketown.in
ADMIN_PASSWORD=

# ---------- Cloudinary: product images ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=caketown

# ---------- Razorpay: online payments (use rzp_test_ keys first) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → URL https://<api>/api/v1/payments/razorpay/webhook
# Events: payment.captured, order.paid, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_HOLD_MINUTES=30

# ---------- Redis (Upstash): caching + shared rate limits ----------
# Upstash → your database → "Connect" → ioredis URL, e.g. rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=

# ---------- Email (Resend) ----------
RESEND_API_KEY=
# Must be on a domain you verified in Resend.
EMAIL_FROM=caketown <orders@caketown.in>
# New orders and contact-form messages are sent here.
SHOP_EMAIL=

# ---------- SMS (MSG91) — templates must be DLT-approved in India ----------
MSG91_AUTH_KEY=
# Flow template with variables ##name##, ##order##, ##status##
MSG91_TEMPLATE_ORDER_UPDATE=
# Flow template with variable ##otp##
MSG91_TEMPLATE_OTP=

# ---------- Expo push notifications (optional; adds security) ----------
EXPO_ACCESS_TOKEN=

LOG_LEVEL=info
