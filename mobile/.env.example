# Address of the caketown API as the phone sees it.
#  - Android emulator: http://10.0.2.2:5000
#  - iOS simulator:    http://localhost:5000
#  - Real phone on the same Wi-Fi: http://<your computer's LAN IP>:5000
#  - Production: https://api.caketown.in
EXPO_PUBLIC_API_URL=http://localhost:5000

